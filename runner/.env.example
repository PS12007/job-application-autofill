# Copy to .env (never committed). One password for every Workday account.
WORKDAY_PASSWORD=
# Optional: sign in with a different email than personal.email in profile.json
WORKDAY_EMAIL=

# Optional: open account verification emails automatically (read-only IMAP).
# Use an app password, never your real email password.
#   Gmail: turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
#   Outlook / Yahoo / iCloud: "app password" in the account's security settings
IMAP_PASSWORD=
# Optional: defaults to the email above / personal.email, and a host guessed from it
IMAP_USER=
IMAP_HOST=

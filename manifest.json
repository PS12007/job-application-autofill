{
  "manifest_version": 3,
  "name": "Job Application Autofill (Personal)",
  "version": "0.3.0",
  "description": "Fills job applications (Workday, Greenhouse and other sites) from a locally stored profile. Optional auto-advance; never clicks Submit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Job Application Autofill",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/shared/storage.js",
        "src/content/selectors.js",
        "src/content/greenhouse/selectors.js",
        "src/content/sites.js",
        "src/content/log.js",
        "src/content/dom.js",
        "src/content/match.js",
        "src/content/inputs.js",
        "src/content/reactSelect.js",
        "src/content/highlight.js",
        "src/content/context.js",
        "src/content/steps.js",
        "src/content/sections.js",
        "src/content/fillers/myInformation.js",
        "src/content/fillers/myExperience.js",
        "src/content/fillers/questions.js",
        "src/content/fillers/disclosures.js",
        "src/content/greenhouse/filler.js",
        "src/content/generic/selectors.js",
        "src/content/generic/fields.js",
        "src/content/generic/filler.js",
        "src/content/autoAdvance.js",
        "src/content/dump.js",
        "src/content/floatingButton.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
